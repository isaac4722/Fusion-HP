<!--
  ServicePage.xaml — «Culto»: orden del servicio con editor completo
  (canción actual, pasaje, imagen, texto/aviso, blanco, video) + planes JSON.
-->
<UserControl x:Class="lumina.wpf.ServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <DockPanel>
    <local:PageHeader DockPanel.Dock="Top" Title="Culto"
                      Subtitle="Orden del servicio: canciones, pasajes y proyección"
                      Icon="{StaticResource IconClipboard}"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="6.5*"/>
        <ColumnDefinition Width="3.5*"/>
      </Grid.ColumnDefinitions>

      <!-- ======== lista del culto ======== -->
      <local:Card Grid.Column="0" Title="Ítems del culto" Icon="{StaticResource IconList}"
                  Margin="0,0,14,0">
        <DockPanel>
          <!-- botones (3 filas con icono, sin recorte) -->
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconUp}" Text="Subir"
                             Margin="0,0,6,6" Click="OnMoveUp"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconDown}" Text="Bajar"
                             Margin="0,0,6,6" Click="OnMoveDown"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconTrash}" Text="Eliminar"
                             Margin="0,0,6,6" Click="OnRemove"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconVideo}" Text="Video…"
                             Margin="0,0,6,6" Click="OnAddVideo"/>
            <local:LumButton Variant="Primary" Icon="{StaticResource IconSong}" Text="Canción actual"
                             Margin="0,0,6,6" Click="OnAddCurrentSong"/>
            <local:LumButton Variant="Primary" Icon="{StaticResource IconBook}" Text="Pasaje bíblico"
                             Margin="0,0,6,6" Click="OnAddCurrentScripture"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconImage}" Text="Imagen…"
                             Margin="0,0,6,6" Click="OnAddImage"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconMessage}" Text="Texto/aviso…"
                             Margin="0,0,6,6" Click="OnAddText"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconBlack}" Text="En blanco"
                             Margin="0,0,0,6" Click="OnAddBlank"/>
            <local:LumButton Variant="Primary" Icon="{StaticResource IconEdit}" Text="Diapositiva (lienzo)…"
                             Margin="0,0,6,6" Click="OnNewSlide"
                             ToolTip="Editor estilo PowerPoint: lienzo libre con elementos de texto/imagen que se arrastran, redimensionan y editan en el sitio — v7.1.0"/>
          </WrapPanel>

          <!-- nombre -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Nombre:" Style="{StaticResource TxtLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="txtServiceName" Width="240" Text="Culto"/>
          </StackPanel>

          <ListBox x:Name="lstItems" Margin="0,10,0,4"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MouseDoubleClick="OnItemDoubleClick"
                   KeyDown="OnItemsKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3,0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" CornerRadius="5" Background="#24FFFFFF"
                          Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Style="{StaticResource TxtSmall}"
                             Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                             Margin="8,0,6,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TxtBody}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TxtCaption}"
                               Foreground="{StaticResource TextDisabledBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </local:Card>

      <!-- ======== acciones ======== -->
      <local:Card Grid.Column="1" Title="Acciones" Icon="{StaticResource IconShare}">
        <DockPanel>
          <local:LumButton DockPanel.Dock="Bottom" Variant="Primary" Icon="{StaticResource IconPlay}"
                           Text="Enviar a proyección" MinHeight="42" Click="OnSendToStage"/>
          <StackPanel VerticalAlignment="Top">
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconSong}"
                             Text="Importar canción JSON…" HorizontalAlignment="Stretch"
                             Click="OnImportSongJson"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconBook}"
                             Text="Importar Biblia .BIB…" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                             Click="OnImportBib"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconClipboard}"
                             Text="Importar plan JSON…" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                             Click="OnImportPlan"/>
            <local:LumButton Variant="Primary" Icon="{StaticResource IconFileText}"
                             Text="Agregar PPTX…" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                             ToolTip="Agrega la presentación PowerPoint ORIGINAL al culto — sin extracción: se proyecta completa con PowerPoint (vía automatización COM) al ponerla en vivo"
                             Click="OnImportPptx"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconFileText}"
                             Text="Importar PPTX (solo texto)…" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                             ToolTip="Opción secundaria: lee solo las cajas de texto del PPTX y las agrega como ítems de texto (1 diapositiva = 1 ítem)"
                             Click="OnImportPptxText"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconSave}"
                             Text="Guardar plan JSON…" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                             ToolTip="Exporta el culto completo (ítems, notas del director y resaltados) a un plan JSON re-importable"
                             Click="OnSavePlan"/>
            <TextBlock Style="{StaticResource TxtCaption}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="El plan JSON admite items: song (title/artist/lyrics), scripture (ref/version), text, blank, pptx (pptxPath — archivo original) y composed (elements — diapositivas del Diseño)."/>
          </StackPanel>
        </DockPanel>
      </local:Card>
    </Grid>
  </DockPanel>
</UserControl>
