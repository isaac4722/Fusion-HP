<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>lumina.tests</RootNamespace>
    <AssemblyName>Lumina.Tests</AssemblyName>
    <Summary>Arnés de pruebas propio (selftest) para la capa gestionada: MiniJson, builder, settings, exportadores PPTX/PDF, Zefania XML, activadores, ObsProtocol y núcleo nativo.</Summary>
    <!-- LUMINA_SKIP_NATIVE=1 → salta los chequeos nativos contándolos como SKIPPED. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Lumina.Core/Lumina.Core.csproj" />
    <ProjectReference Include="../Lumina.Bridge/Lumina.Bridge.csproj" />
  </ItemGroup>

  <!-- DeflateStream (lector ZIP del arnés) en .NET Framework -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

</Project>
