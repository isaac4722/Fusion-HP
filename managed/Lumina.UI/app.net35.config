<?xml version="1.0" encoding="utf-8"?>
<!--
  LuminaPresentation (variante .NET 3.5) — app.net35.config
  La baseline corre sobre el PRIMER CLR disponible en este orden:
    1. v2.0.50727 (CLR 2.0 — .NET Framework 2.0/3.0/3.5, de fábrica en Win7 SP1)
    2. v4.0       (CLR 4.0 — .NET Framework 4.x, de fábrica en Win10 1903+/Win11)
  Así el mismo binario ABRE en cualquier Windows con .NET ≥ 3.5; el launcher
  prefiere la variante net48 cuando el equipo tiene 4.8 (meta del proyecto:
  «mínimo 3.5, usa 4.8 si está disponible»).
-->
<configuration>
  <startup>
    <supportedRuntime version="v2.0.50727"/>
    <supportedRuntime version="v4.0"/>
  </startup>
</configuration>
