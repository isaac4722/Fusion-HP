// ============================================================================
//  LuminaPresentation Suite - Recurso de Windows (icono + version)
// ============================================================================
#include <windows.h>

#define VER_FILEVERSION             1,0,0,0
#define VER_FILEVERSION_STR         "1.0.0.0\0"
#define VER_PRODUCTVERSION          1,0,0,0
#define VER_PRODUCTVERSION_STR      "1.0.0\0"

IDI_ICON1 ICON "resources\\img\\app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "CompanyName",      "LuminaSoftware"
            VALUE "FileDescription",  "LuminaPresentation Suite - Proyeccion Multimedia Hibrida"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "LuminaPresentationSuite"
            VALUE "LegalCopyright",   "(c) 2026 Isaac. Licencia View-Only."
            VALUE "OriginalFilename", "LuminaPresentationSuite.exe"
            VALUE "ProductName",      "LuminaPresentation Suite"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
