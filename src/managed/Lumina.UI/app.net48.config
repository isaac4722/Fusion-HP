<?xml version="1.0" encoding="utf-8"?>
<!--
  LuminaPresentation (variante .NET 4.8) — app.net48.config
  Solo CLR 4.0: es la meta preferida del launcher cuando el equipo tiene
  .NET Framework 4.8+ (integrado en Windows 10 1903+ y Windows 11).
  NUNCA listamos v2.0.50727 aquí: un exe compilado contra mscorlib 4.0 no
  puede ejecutarse sobre el CLR 2.0.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0"/>
  </startup>
</configuration>
