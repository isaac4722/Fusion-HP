<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net35;net48</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <RootNamespace>lumina.ui</RootNamespace>
    <AssemblyName Condition="'$(TargetFramework)' == 'net35'">LuminaPresentation35</AssemblyName>
    <AssemblyName Condition="'$(TargetFramework)' != 'net35'">LuminaPresentation</AssemblyName>
    <Summary>Interfaz WinForms de LuminaPresentation Suite (vía A: C# dueño del proceso).</Summary>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- v5.1.0 «FUNDAMENTO»: el paquete portable lleva AMBAS variantes
         (net48\LuminaPresentation.exe y net35\LuminaPresentation35.exe);
         el launcher nativo elige según el CLR del equipo. La baseline net35
         ABIENCA en cualquier Windows con .NET ≥ 3.5 y su app.config acepta
         tanto CLR2 como CLR4 (ver app.net35.config / app.net48.config). -->
    <AppConfig Condition="'$(TargetFramework)' == 'net35'">app.net35.config</AppConfig>
    <AppConfig Condition="'$(TargetFramework)' != 'net35'">app.net48.config</AppConfig>
    <!--
      DECISIÓN DOCUMENTADA: <UseWindowsForms> FUNCIONA en net35+net48 con el SDK
      de .NET 8 en Linux SIEMPRE QUE (a) el paquete de ref assemblies esté
      presente (Directory.Build.props) y (b) EnableWindowsTargeting=true. Se
      verificó localmente: net35 y net48 compilan System.Windows.Forms sin
      errores → la UI MANTIENE la dualidad net35;net48 (no fue necesario
      recortarla a net48). En ejecución real, net35 requiere el CLR 2.0/3.5 del
      sistema (Win7 SP1 lo trae de fábrica) y GDI+ (gdiplus.dll, presente).
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Lumina.Core/Lumina.Core.csproj" />
    <ProjectReference Include="../Lumina.Bridge/Lumina.Bridge.csproj" />
    <ProjectReference Include="../Lumina.Api/Lumina.Api.csproj" />
  </ItemGroup>

</Project>
