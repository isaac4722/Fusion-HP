<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Fusion.Studio</RootNamespace>
    <AssemblyName>FusionStudio</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.3.0</Version>
    <AssemblyTitle>Fusion HP Studio</AssemblyTitle>
    <Product>Fusion HP</Product>
    <Description>Estudio de presentación litúrgica híbrido (Win7 x86 → Win11 x64)</Description>
    <Company>Fusion HP</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <ProjectReference Include="..\FusionShared\FusionShared.csproj" />
  </ItemGroup>

</Project>
