<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Fusion.Studio</RootNamespace>
    <AssemblyName>FusionStudio</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>4.1.1</Version>
    <AssemblyTitle>Fusion HP Studio</AssemblyTitle>
    <Product>Fusion HP</Product>
    <Description>Estudio de presentación litúrgica híbrido (Win7 x86 → Win11 x64)</Description>
    <Company>Fusion HP</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <ProjectReference Include="..\FusionShared\FusionShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NLog 4.7.15 (BSD-3, net35) — log estructurado [DEPENDENCIAS.md] -->
    <Reference Include="NLog">
      <HintPath>..\..\..\third_party\net\NLog\4.7.15\NLog.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- PDFsharp 6.1.1 (MIT, netstandard2.0) — IFontResolver con bytes de las
         fuentes del producto: incrustación real. Motivo de la desviación de
         versión en DEPENDENCIAS.md (1.50 tiene XPrivateFontCollection stub) -->
    <Reference Include="PdfSharp">
      <HintPath>..\..\..\third_party\net\PdfSharp\6.1.1\PdfSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PdfSharp.System">
      <HintPath>..\..\..\third_party\net\PdfSharp\6.1.1\PdfSharp.System.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>..\..\..\third_party\net\Microsoft.Extensions.Logging.Abstractions\6.0.0\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- DocumentFormat.OpenXml 2.7.2 (MIT, net40) — SOLO FusionStudio net48;
         FusionShared y Lite (net35) nunca lo cargan [DEPENDENCIAS.md] -->
    <Reference Include="DocumentFormat.OpenXml">
      <HintPath>..\..\..\third_party\net\DocumentFormat.OpenXml\2.7.2\DocumentFormat.OpenXml.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ookii.Dialogs 1.0.0 (BSD-3, net35) — VistaFolderBrowserDialog nativo;
         solo diálogos, nada de JumpLists (escribirían registro) [DEPENDENCIAS.md] -->
    <Reference Include="Ookii.Dialogs.Wpf">
      <HintPath>..\..\..\third_party\net\Ookii.Dialogs\1.0.0\Ookii.Dialogs.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
