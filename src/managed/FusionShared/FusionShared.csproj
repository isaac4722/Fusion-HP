<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Fusion.Shared</RootNamespace>
    <AssemblyName>FusionShared</AssemblyName>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>4.0.1</Version>
    <AssemblyTitle>Fusion Shared</AssemblyTitle>
    <Product>Fusion HP</Product>
    <!-- net35: compilable con SDK moderno vía ensamblados de referencia [SPEC §3.5] -->
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <!-- Newtonsoft.Json 13.0.3 (MIT, net35) — motor detrás de la fachada JsonValue [DEPENDENCIAS.md] -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\..\third_party\net\Newtonsoft.Json\13.0.3\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
