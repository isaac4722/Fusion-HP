<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Fusion.Shared</RootNamespace>
    <AssemblyName>FusionShared</AssemblyName>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>4.0.1</Version>
    <AssemblyTitle>Fusion Shared</AssemblyTitle>
    <Product>Fusion HP</Product>
    <!-- net35: compilable con SDK moderno vía ensamblados de referencia [SPEC §3.5] -->
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
