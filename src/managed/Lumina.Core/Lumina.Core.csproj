<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 añadido en v5.0.0: los exportadores (PPTX/PDF) y los módulos
         puros (Zefania/Triggers/ObsProtocol) se validan en el arnés net8.0
         del CI — Deflate/Xml son BCL integradas allí.
         v5.1.0: System.IO.Packaging (WindowsBase) RETIRADO — el OPC/PPTX se
         empaqueta con ZipWriter propio (Export/ZipWriter.cs) → las builds
         net35/net48/net8 comparten el MISMO código portable. -->
    <TargetFrameworks>net35;net48;net8.0</TargetFrameworks>
    <RootNamespace>lumina.core</RootNamespace>
    <AssemblyName>Lumina.Core</AssemblyName>
    <Summary>Núcleo de datos gestionado de LuminaPresentation: MiniJson, modelos, builder de escenarios, ajustes portables, exportación PPTX/PDF, Zefania XML, activadores y protocolo OBS.</Summary>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <!-- v5.1.0: WindowsBase ELIMINADO — el OPC/PPTX se empaqueta con ZipWriter
         propio (Export/ZipWriter.cs). Antes: System.IO.Packaging (WindowsBase)
         resolvía distinto entre CLR2 (3.0) y CLR4 (4.0) y ataba la variante
         net35 al GAC 3.x — la baseline ahora corre bajo 3.5 Y 4.8 igual. -->
    <Reference Include="System.Xml" />
    <Reference Include="System" />
    <!-- DeflateStream: System.dll en net35 (2.0+); System.IO.Compression.dll en net48. -->
    <Reference Include="System.IO.Compression" Condition="'$(TargetFramework)' != 'net35'" />
  </ItemGroup>

  <!-- v5.1.0: sin PackageReferences funcionales en NINGÚN TFM — el OPC y el
       ZIP son motores propios (ZipWriter/ZipBackup) y los tests net8 usan el
       mismo código que las builds reales que se distribuyen. -->
</Project>
