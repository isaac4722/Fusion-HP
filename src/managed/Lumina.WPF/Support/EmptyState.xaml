<!--
  EmptyState.xaml — estado vacío explicativo (listas sin contenido).
  La lista explica QUÉ hacer en lugar de parecer «rota» (regla de UX:
  reconocimiento sobre recuerdo; guía de siguiente paso visible).
-->
<UserControl x:Class="lumina.wpf.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <Path Data="{Binding Icon, RelativeSource={RelativeSource AncestorType=local:EmptyState}}"
          Style="{StaticResource IconStroke}"
          Width="42" Height="42" Opacity="0.5"
          Stroke="{StaticResource TextDisabledBrush}"
          HorizontalAlignment="Center" Margin="0,0,0,10"/>
    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:EmptyState}}"
               Style="{StaticResource TxtH2}" Foreground="{StaticResource TextSecondaryBrush}"
               HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding Note, RelativeSource={RelativeSource AncestorType=local:EmptyState}}"
               Style="{StaticResource TxtSmall}" Foreground="{StaticResource TextDisabledBrush}"
               HorizontalAlignment="Center" Margin="0,5,0,0" MaxWidth="420"
               TextWrapping="Wrap" TextAlignment="Center"/>
  </StackPanel>
</UserControl>
