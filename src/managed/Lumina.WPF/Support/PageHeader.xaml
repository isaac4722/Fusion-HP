<!--
  PageHeader.xaml — cabecera de página: badge de icono + título + subtítulo + divisoria.
-->
<UserControl x:Class="lumina.wpf.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <StackPanel Margin="0,2,0,12">
    <StackPanel Orientation="Horizontal">
      <Border CornerRadius="9"
              Background="{StaticResource AccentLayerBrush}"
              BorderBrush="#38F0A93B" BorderThickness="1"
              Width="36" Height="36" VerticalAlignment="Center">
        <Path Data="{Binding Icon, RelativeSource={RelativeSource AncestorType=local:PageHeader}}"
              Style="{StaticResource IconStroke}"
              Width="19" Height="19"
              Stroke="{StaticResource AccentBrush}"/>
      </Border>
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:PageHeader}}"
                   Style="{StaticResource TxtH1}"/>
        <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=local:PageHeader}}"
                   Style="{StaticResource TxtSmall}" Margin="0,1,0,0"/>
      </StackPanel>
    </StackPanel>
    <Separator Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,11,0,0"/>
  </StackPanel>
</UserControl>
