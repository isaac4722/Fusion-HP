<!--
  StudioPage.xaml — «Estudio» (modo create del flujo PowerStudio, referencia
  H-P-Web-Version-Ref): cinta de tareas + tira de miniaturas + lienzo 16:9 con
  elementos arrastrables (texto/imagen) + panel de propiedades y notas.
  Las diapositivas usan el modelo ComposedElement (0..1) — se proyectan por el
  núcleo, se exportan a PPTX/PDF/imágenes y viajan en el plan JSON del culto.
-->
<UserControl x:Class="lumina.wpf.StudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <DockPanel>

    <!-- ================= CINTA (ribbon) ================= -->
    <Border DockPanel.Dock="Top" CornerRadius="8" BorderThickness="1"
            BorderBrush="{StaticResource CardBorderBrush}"
            Background="{StaticResource CardBrush}" Margin="0,0,0,10" Padding="10,7">
      <WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
          <TextBlock Text="DIAPOSITIVA" Style="{StaticResource TxtCaption}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <local:LumButton Variant="Primary" Icon="{StaticResource IconType}" Text="Título"
                           MinWidth="92" Margin="0,0,6,6" Click="OnAddTitle"
                           ToolTip="Añade una diapositiva de título (Ctrl+N)"/>
          <local:LumButton Variant="Secondary" Icon="{StaticResource IconType}" Text="Texto"
                           MinWidth="92" Margin="0,0,6,6" Click="OnAddText"/>
          <local:LumButton Variant="Secondary" Icon="{StaticResource IconImage}" Text="Imagen"
                           MinWidth="96" Margin="0,0,6,6" Click="OnAddImage"/>
          <local:LumButton Variant="Secondary" Icon="{StaticResource IconCopy}" Text="Duplicar"
                           MinWidth="96" Margin="0,0,6,6" Click="OnDuplicate"/>
          <local:LumButton Variant="Danger" Icon="{StaticResource IconTrash}" Text="Eliminar"
                           MinWidth="96" Margin="0,0,6,6" Click="OnDeleteSlide"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
          <TextBlock Text="CULTO" Style="{StaticResource TxtCaption}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <local:LumButton Variant="Primary" Icon="{StaticResource IconSave}"
                           Text="Guardar en el culto" MinWidth="170" Margin="0,0,6,6"
                           ToolTip="Serializa TODAS las diapositivas del Estudio como ítems del culto (se exportan y proyectan con el tema activo)"
                           Click="OnSaveToService"/>
          <local:LumButton Variant="Secondary" Icon="{StaticResource IconFolder}"
                           Text="Cargar del culto" MinWidth="150" Margin="0,0,6,6"
                           ToolTip="Trae al Estudio los diseños (lienzos) ya presentes en el culto"
                           Click="OnLoadFromService"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
          <TextBlock Text="PRESENTAR" Style="{StaticResource TxtCaption}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <local:LumButton Variant="Primary" Icon="{StaticResource IconLive}"
                           Text="EN VIVO (F5)" MinWidth="130" Margin="0,0,6,6"
                           Click="OnGoLive"/>
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- ================= CUERPO: miniaturas | lienzo | propiedades ===== -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="270"/>
      </Grid.ColumnDefinitions>

      <!-- miniaturas -->
      <local:Card Grid.Column="0" Title="Diapositivas" Icon="{StaticResource IconGrid}"
                  Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" x:Name="txtStudioCount" Style="{StaticResource TxtCaption}"
                     Text="0 diapositivas" Margin="2,6,0,0"/>
          <ListBox x:Name="lstThumbs" BorderThickness="0" Background="Transparent"
                   SelectionChanged="OnThumbSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,4,2,4">
                  <Border CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                          Background="{StaticResource PreviewBrush}" Height="64">
                    <Grid>
                      <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextDisabledBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,2,0,0"/>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource TxtSmall}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"
                                 Margin="8,0,6,4"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </local:Card>

      <!-- lienzo 16:9 -->
      <local:Card Grid.Column="1" Title="Lienzo" Icon="{StaticResource IconEdit}" Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" x:Name="txtCanvasHint" Style="{StaticResource TxtCaption}"
                     Margin="0,8,0,0"
                     Text="Arrastra para mover · esquina inferior-derecha para redimensionar · doble clic edita el texto"/>
          <Grid>
            <Viewbox Stretch="Uniform" MaxHeight="520">
              <Canvas x:Name="canvasHost" Width="960" Height="540"
                      Background="{StaticResource PreviewBrush}"
                      MouseLeftButtonDown="OnCanvasBackgroundClick"/>
            </Viewbox>
            <local:EmptyState x:Name="emptyStudio" Icon="{StaticResource IconEdit}"
                              Title="Sin diapositivas"
                              Note="Pulsa «Título», «Texto» o «Imagen» en la cinta para crear la primera"
                              IsHitTestVisible="False"/>
          </Grid>
        </DockPanel>
      </local:Card>

      <!-- propiedades -->
      <local:Card Grid.Column="2" Title="Propiedades" Icon="{StaticResource IconSliders}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="Notas del director (no se proyectan):" Style="{StaticResource TxtCaption}"
                       Margin="0,8,0,2"/>
            <TextBox x:Name="txtNotes" MinHeight="52" AcceptsReturn="True"
                     TextChanged="OnNotesChanged" VerticalScrollBarVisibility="Auto"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Título de la diapositiva:" Style="{StaticResource TxtCaption}"/>
            <TextBox x:Name="txtSlideTitle" MinHeight="28" Margin="0,3,0,8"
                     TextChanged="OnTitleChanged"/>
            <TextBlock Text="Texto del elemento seleccionado:" Style="{StaticResource TxtCaption}"/>
            <TextBox x:Name="txtElementText" MinHeight="92" AcceptsReturn="True" Margin="0,3,0,8"
                     TextChanged="OnElementTextChanged" VerticalScrollBarVisibility="Auto"
                     IsEnabled="False"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="Tamaño (% alto):" Style="{StaticResource TxtCaption}"/>
                <TextBox x:Name="txtFontSize" MinHeight="28" Margin="0,3,0,0"
                         TextChanged="OnFontSizeChanged" IsEnabled="False"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="Alineación:" Style="{StaticResource TxtCaption}"/>
                <ComboBox x:Name="cmbAlign" MinHeight="30" Margin="0,3,0,0" SelectionChanged="OnAlignChanged"
                          IsEnabled="False">
                  <ComboBoxItem Content="Izquierda"/>
                  <ComboBoxItem Content="Centro" IsSelected="True"/>
                  <ComboBoxItem Content="Derecha"/>
                </ComboBox>
              </StackPanel>
            </Grid>
          </StackPanel>
        </DockPanel>
      </local:Card>
    </Grid>
  </DockPanel>
</UserControl>
