<!--
  LivePage.xaml — «En Vivo»: transporte compacto con tooltips/atajos, lista de
  diapositivas alta con insignias + barra ámbar, vista previa 16:9 con borde
  «en vivo» e información «Jn 3:16 · Diapositiva 2 de 5», y fila de salida.
-->
<UserControl x:Class="lumina.wpf.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <DockPanel>
    <local:PageHeader DockPanel.Dock="Top" Title="En Vivo"
                      Subtitle="Proyección en tiempo real del escenario"
                      Icon="{StaticResource IconLive}"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="408"/>
      </Grid.ColumnDefinitions>

      <!-- ======== izquierda: escenario (ítems + slides) + transporte ======== -->
      <local:Card Grid.Column="0" Title="Escenario" Icon="{StaticResource IconList}"
                  Margin="0,0,14,0">
        <DockPanel>
          <!-- F1.07: búsqueda EN CALIENTE — visible durante la proyección;
               buscar/añadir NO interrumpe la salida (solo agrega al escenario
               pendiente; proyectar sigue siendo una acción explícita). -->
          <Border DockPanel.Dock="Top" CornerRadius="8" BorderThickness="1"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  Background="{StaticResource RowEvenBrush}" Margin="0,0,0,8"
                  FocusManager.FocusedElement="{Binding ElementName=txtHotSearch}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="txtHotSearch" MinHeight="30" Margin="8,6,0,6" VerticalContentAlignment="Center"
                       KeyDown="OnHotSearchKeyDown" TextChanged="OnHotSearchTextChanged"
                       ToolTip="Búsqueda en caliente (Ctrl+K): canciones y versículos sin interrumpir la proyección — Enter agrega el resultado seleccionado al escenario"/>
              <TextBlock Grid.Column="0" Text=" Buscar canción o versículo…   (Ctrl+K)" IsHitTestVisible="False"
                         Foreground="{StaticResource TextDisabledBrush}"
                         VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource TxtSmall}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=txtHotSearch}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Column="1" Text="Ctrl+K" Style="{StaticResource TxtCaption}"
                         Foreground="{StaticResource TextDisabledBrush}" Margin="8,0,12,0"
                         VerticalAlignment="Center"/>
              <Popup x:Name="popHotSearch" Grid.Column="0" PlacementTarget="{Binding ElementName=txtHotSearch}"
                     Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="560">
                <Border CornerRadius="8" BorderThickness="1.2" Background="{StaticResource PageBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" Padding="4" MaxHeight="340">
                  <ListBox x:Name="lstHotResults" BorderThickness="0" Background="Transparent"
                           KeyDown="OnHotResultKeyDown" MouseDoubleClick="OnHotResultDoubleClick">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="2,3,2,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding KindLabel}" Style="{StaticResource TxtSmall}"
                                     Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding RefLabel}" Style="{StaticResource TxtSmall}"
                                     TextTrimming="CharacterEllipsis" Margin="4,0,6,0"/>
                          <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource TxtSmall}"
                                     TextTrimming="CharacterEllipsis"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
              </Popup>
            </Grid>
          </Border>

          <!-- fila 3: salida (pantalla + proyección) -->
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <ComboBox x:Name="cmbScreen" Width="150" MinHeight="30"
                      ToolTip="Pantalla donde se abre la ventana de proyección"
                      SelectionChanged="OnScreenChanged"/>
            <CheckBox x:Name="chkFullscreen" Content="Pantalla completa" Margin="12,6,12,0"
                      VerticalAlignment="Center" IsChecked="True"
                      Checked="OnFullscreenChanged" Unchecked="OnFullscreenChanged"
                      ToolTip="La ventana de proyección es SIEMPRE sin bordes; esto la lleva a cubrir el monitor completo"/>
            <local:LumButton x:Name="btnProjector" Variant="Secondary" Icon="{StaticResource IconCast}"
                             Text="Proyector" Click="OnProjectorClick"
                             ToolTip="Mostrar/ocultar la ventana de proyección (F5) — sin bordes; cerrarla con X o ESC no la duplica y se puede reabrir"/>
          </StackPanel>

          <!-- fila 2: herramientas -->
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,7,0,0">
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconUsers}" Text=""
                             ToolTip="Monitor de escenario (F6)" Margin="0,0,6,0"
                             Click="OnStageClick"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconUser}" Text=""
                             ToolTip="Ventana de director (F7)" Margin="0,0,6,0"
                             Click="OnDirectorClick"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconMessage}" Text=""
                             ToolTip="Zócalo inferior / aviso (F8)" Margin="0,0,6,0"
                             Click="OnThirdClick"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconPause}" Text=""
                             ToolTip="Pausar el video en la salida (P)" Margin="0,0,6,0"
                             Click="OnVideoPauseClick"/>
            <local:LumButton Variant="Danger" Icon="{StaticResource IconClose}" Text=""
                             ToolTip="Limpiar la salida (L)" Click="OnClearClick"/>
          </StackPanel>

          <!-- fila 1: transporte -->
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconPrev}" Text=""
                             ToolTip="Diapositiva anterior (← / RePág)" Margin="0,0,7,0"
                             Click="OnPrevClick"/>
            <local:LumButton Variant="Primary" Icon="{StaticResource IconPlay}" Text="EN VIVO"
                             MinWidth="118" Margin="0,0,7,0"
                             ToolTip="Proyectar la diapositiva seleccionada (Enter o doble clic en la lista)"
                             Click="OnLiveClick"/>
            <local:LumButton Variant="Secondary" Icon="{StaticResource IconNext}" Text=""
                             ToolTip="Diapositiva siguiente (→ / Espacio / AvPág)" Margin="0,0,7,0"
                             Click="OnNextClick"/>
            <local:LumButton x:Name="btnBlack" Variant="Danger" Icon="{StaticResource IconBlack}"
                             Text="Negro" MinWidth="96" Margin="0,0,7,0"
                             ToolTip="Ocultar la salida en negro (B) — el botón se enciende en rojo"
                             Click="OnBlackClick"/>
            <local:LumButton Variant="Ghost" Icon="{StaticResource IconHelp}" Text=""
                             ToolTip="Atajos de teclado (F1)" Click="OnHelpClick"/>
          </StackPanel>

          <!-- ======== lista de ÍTEMS del escenario (v7.1.0 «OPERADOR») ======== -->
          <TextBlock x:Name="txtScenarioName" DockPanel.Dock="Top" Text="Sin escenario cargado"
                     Style="{StaticResource TxtH2}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
          <Grid MinHeight="110">
            <Grid.RowDefinitions>
              <RowDefinition Height="1.1*"/>
              <RowDefinition Height="5"/>
              <RowDefinition Height="1.6*"/>
            </Grid.RowDefinitions>
            <!-- ítems (canción/pasaje/texto/presentación…): clic = ver sus slides,
                 doble clic = proyectar su primera slide -->
            <ListBox x:Name="lstItems" Grid.Row="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnItemsSelectionChanged" MouseDoubleClick="OnItemsDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/>
                      <ColumnDefinition Width="82"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="5" Background="#24FFFFFF"
                            Padding="3,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Number}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Style="{StaticResource TxtSmall}"
                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                               Margin="6,0,6,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Title}" Style="{StaticResource TxtBody}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding SlideCount}" Style="{StaticResource TxtCaption}"
                               Foreground="{StaticResource TextDisabledBrush}" Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Rectangle Grid.Row="1" Fill="{StaticResource CardBorderBrush}" Height="1"/>
            <!-- slides del ítem seleccionado: clic = leer texto completo (sin
                 proyectar), doble clic / Enter = proyectar -->
            <ListBox x:Name="lstSlides" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSlidesSelectionChanged"
                     MouseDoubleClick="OnSlidesDoubleClick"
                     KeyDown="OnSlidesKeyDown">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="5" Background="#24FFFFFF"
                            Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="{Binding IndexLabel}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding RefLabel}" Style="{StaticResource TxtSmall}"
                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                               Margin="10,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding FirstLine}" Style="{StaticResource TxtBody}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <local:EmptyState x:Name="emptySlides" Grid.Row="0" Icon="{StaticResource IconList}"
                              Title="Sin escenario cargado"
                              Note="Carga una canción, un pasaje bíblico o el culto desde las otras páginas"
                              Background="{StaticResource RowEvenBrush}" IsHitTestVisible="False"/>
          </Grid>
        </DockPanel>
      </local:Card>

      <!-- ======== derecha: vista previa + TEXTO COMPLETO (v7.1.0) ======== -->
      <local:Card Grid.Column="1" Title="Vista previa" Icon="{StaticResource IconEye}">
        <DockPanel>
          <!-- pie: refrescar + nota de la fuente -->
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,9,0,0">
            <local:LumButton Variant="Ghost" Icon="{StaticResource IconRefresh}" Text="Refrescar"
                             ToolTip="Volver a pedir la vista previa al núcleo" Click="OnRefreshClick"/>
            <TextBlock Text="Vista previa del núcleo (PNG)" Style="{StaticResource TxtCaption}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="txtPreviewInfo" DockPanel.Dock="Bottom" Text="Sin diapositivas en el escenario"
                     Style="{StaticResource TxtSmall}" Margin="0,8,0,0"/>

          <!-- v7.1.0 «OPERADOR» (feedback #4): TEXTO COMPLETO de la slide
               seleccionada — la Biblia (o cualquier ítem) se lee ENTERA desde
               el modo Operador SIN proyectarla. -->
          <Border DockPanel.Dock="Bottom" CornerRadius="8" BorderThickness="1.2"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  Background="{StaticResource RowEvenBrush}" Margin="0,10,0,0"
                  MinHeight="96" MaxHeight="190">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" x:Name="txtFullTextLabel" Text="Texto completo (sin proyectar)"
                         Style="{StaticResource TxtCaption}" Margin="8,5,8,3"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtFullText" Style="{StaticResource TxtBody}"
                           TextWrapping="Wrap" Margin="8,0,8,8"/>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Border x:Name="previewBorder" CornerRadius="8" BorderThickness="1.4"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  Background="{StaticResource PreviewBrush}" ClipToBounds="True">
            <Grid>
              <Image x:Name="imgPreview" Stretch="Uniform" Margin="4"/>
              <TextBlock x:Name="txtNoPreview" Text="Carga una canción o pasaje para ver la vista previa"
                         Style="{StaticResource TxtSmall}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" TextAlignment="Center" MaxWidth="300"
                         TextWrapping="Wrap" IsHitTestVisible="False"/>
              <local:Chip x:Name="chipLive" Text="EN VIVO" HorizontalAlignment="Right"
                          VerticalAlignment="Top" Margin="0,12,12,0" Visibility="Collapsed"/>
            </Grid>
          </Border>
        </DockPanel>
      </local:Card>
    </Grid>
  </DockPanel>
</UserControl>
