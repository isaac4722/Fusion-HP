<!--
  IntegrationsPage.xaml — «Integraciones»: mando remoto móvil (LAN),
  entrada MIDI (activadores) y módulos JS (v7.1.0 «OPERADOR»: OBS eliminado
  — feedback #5: el control local de OBS se retiró de la app).
-->
<UserControl x:Class="lumina.wpf.IntegrationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <DockPanel>
    <local:PageHeader DockPanel.Dock="Top" Title="Integraciones"
                      Subtitle="Control remoto móvil (LAN) · MIDI · Módulos JS"
                      Icon="{StaticResource IconShare}"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">

        <!-- ======== MIDI ======== -->
        <local:Card Title="Entrada MIDI (activadores)" Icon="{StaticResource IconMic}">
          <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="36"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
              <CheckBox x:Name="chkMidiEnabled" Content="Activar entrada MIDI" VerticalAlignment="Center"
                        Checked="OnMidiAutoApply" Unchecked="OnMidiAutoApply"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        Margin="0,8,0,0">
              <ComboBox x:Name="cmbMidiDevice" Width="300"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconRefresh}"
                               Text="Buscar dispositivos" Margin="8,0,0,0" Click="OnMidiRefresh"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="lblMidiState" Text="● ENTRADA DETENIDA" Style="{StaticResource TxtLabel}"
                     Foreground="{StaticResource TextDisabledBrush}" Margin="0,8,0,0"/>
          </StackPanel>
        </local:Card>

        <!-- ======== Módulos JS (JSLib — v6.1.0) ======== -->
        <local:Card Title="Módulos JS (JSLib · IActiveScript)" Icon="{StaticResource IconTerminal}"
                    Margin="0,14,0,0">
          <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="36"/>
              <RowDefinition Height="40"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
              <CheckBox x:Name="chkJsEnabled" Content="Activar el motor de scripts (módulos .js del usuario)"
                        VerticalAlignment="Center"
                        Checked="OnJsAutoApply" Unchecked="OnJsAutoApply"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Carpeta de módulos" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="txtJsDir" Grid.Row="1" Grid.Column="1" IsReadOnly="True"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
              <local:LumButton x:Name="btnJsReload" Variant="Secondary" Icon="{StaticResource IconRefresh}"
                               Text="Recargar módulos" Click="OnJsReload"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="lblJsState" Text="● MOTOR DETENIDO" Style="{StaticResource TxtLabel}"
                     Foreground="{StaticResource TextDisabledBrush}" Margin="0,8,0,0"/>
          <TextBlock Style="{StaticResource TxtSmall}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Los archivos .js se cargan al activar y con «Recargar»: jslib.log/notify, httpGet(url,cb), tcp/ws persistentes, cmd('next'|'black'…), showText, onEvent('slide_changed'…) y setTimeout. Los payloads de onEvent son JSON — parsearlos con jsonParse()."/>
          <ListBox x:Name="lstJsLog" Height="130" Margin="0,8,0,0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   FontFamily="Consolas"/>
          </StackPanel>
        </local:Card>

        <!-- ======== Remoto ======== -->
        <local:Card Title="Control remoto móvil (red local)" Icon="{StaticResource IconWifi}"
                    Margin="0,14,0,0">
          <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="36"/>
              <RowDefinition Height="40"/>
              <RowDefinition Height="40"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
              <CheckBox x:Name="chkRemoteEnabled" Content="Abrir el mando a los dispositivos de la red"
                        VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Puerto" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <local:LumNumeric x:Name="numRemotePort" Grid.Row="1" Grid.Column="1" Min="1024" Max="65535"
                              Width="100" HorizontalAlignment="Left" Value="8070"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Token de acceso" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="txtRemoteToken" Grid.Row="2" Grid.Column="1"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
              <local:LumButton x:Name="btnRemoteToggle" Variant="Primary" Icon="{StaticResource IconWifi}"
                               Text="Aplicar y abrir mando" Click="OnRemoteApply"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="lblRemoteState" Text="● MANDO DETENIDO" Style="{StaticResource TxtLabel}"
                     Foreground="{StaticResource TextDisabledBrush}" Margin="0,8,0,0"/>
          <TextBlock x:Name="lblRemoteUrl" Text="El mando se abre con el botón o al activarlo en ajustes."
                     Style="{StaticResource TxtSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </local:Card>

        <!-- ======== Opciones de proyección ======== -->
        <local:Card Title="Opciones de proyección" Icon="{StaticResource IconVideo}" Margin="0,14,0,0">
          <CheckBox x:Name="chkAutoAdvanceVideo"
                    Content="Al terminar un video, avanzar automáticamente a la siguiente diapositiva"
                    VerticalAlignment="Center"/>
        </local:Card>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
