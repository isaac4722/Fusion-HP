<!--
  ThemesPage.xaml — «Temas»: editor visual (colores/tipografía/efectos/imagen
  de fondo) con vista previa en vivo (geometría de texto WPF: contorno por
  silueta + sombra) y biblioteca data\themes.
-->
<UserControl x:Class="lumina.wpf.ThemesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <DockPanel>
    <local:PageHeader DockPanel.Dock="Top" Title="Temas"
                      Subtitle="Apariencia de la proyección: colores, tipografía y efectos"
                      Icon="{StaticResource IconDroplet}"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5.5*"/>
        <ColumnDefinition Width="4.5*"/>
      </Grid.ColumnDefinitions>

      <!-- ======== propiedades ======== -->
      <local:Card Grid.Column="0" Title="Propiedades del tema" Icon="{StaticResource IconSliders}"
                  Margin="0,0,14,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Nombre" Style="{StaticResource TxtH2}" Margin="0,2,0,5"/>
            <TextBox x:Name="txtThemeName" Width="260" HorizontalAlignment="Left"
                     TextChanged="OnThemeEdited"/>

            <TextBlock Text="Colores" Style="{StaticResource TxtH2}" Margin="0,14,0,6"/>
            <StackPanel Orientation="Horizontal">
              <StackPanel Width="104" Margin="0,0,14,0">
                <TextBlock Text="Fondo" Style="{StaticResource TxtLabel}"/>
                <Button x:Name="swBg" Height="30" Click="OnPickBg" Cursor="Hand"
                        BorderThickness="1" Tag="B" Background="#FF0B1F2A"/>
                <TextBlock x:Name="hexBg" Text="#FF0B1F2A" Style="{StaticResource TxtCaption}" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Width="104" Margin="0,0,14,0">
                <TextBlock Text="Texto" Style="{StaticResource TxtLabel}"/>
                <Button x:Name="swFg" Height="30" Click="OnPickFg" Cursor="Hand"
                        BorderThickness="1" Tag="F" Background="#FFFFFFFF"/>
                <TextBlock x:Name="hexFg" Text="#FFFFFFFF" Style="{StaticResource TxtCaption}" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Width="104">
                <TextBlock Text="Acento" Style="{StaticResource TxtLabel}"/>
                <Button x:Name="swAccent" Height="30" Click="OnPickAccent" Cursor="Hand"
                        BorderThickness="1" Tag="A" Background="#FF3AA6B9"/>
                <TextBlock x:Name="hexAccent" Text="#FF3AA6B9" Style="{StaticResource TxtCaption}" Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>

            <TextBlock Text="Tipografía" Style="{StaticResource TxtH2}" Margin="0,14,0,6"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Fuente:" Style="{StaticResource TxtLabel}" VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
              <ComboBox x:Name="cmbFont" Width="170" SelectionChanged="OnThemeEdited">
                <ComboBoxItem Content="Segoe UI"/>
                <ComboBoxItem Content="Arial"/>
                <ComboBoxItem Content="Georgia"/>
                <ComboBoxItem Content="Verdana"/>
                <ComboBoxItem Content="Trebuchet MS"/>
                <ComboBoxItem Content="Tahoma"/>
              </ComboBox>
              <TextBlock Text="Tamaño:" Style="{StaticResource TxtLabel}" VerticalAlignment="Center"
                         Margin="14,0,8,0"/>
              <local:LumNumeric x:Name="numSize" Min="12" Max="140" Width="76"
                                ValueChangedByUser="OnNumericChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
              <CheckBox x:Name="chkBold" Content="Negrita" VerticalAlignment="Center"
                        Margin="0,0,14,0" Checked="OnThemeEdited" Unchecked="OnThemeEdited"/>
              <CheckBox x:Name="chkUpper" Content="MAYÚSCULAS" VerticalAlignment="Center"
                        Margin="0,0,14,0" Checked="OnThemeEdited" Unchecked="OnThemeEdited"/>
              <TextBlock Text="Interlineado:" Style="{StaticResource TxtLabel}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <local:LumNumeric x:Name="numLine" Min="0.8" Max="2" Step="0.02" DecimalPlaces="2"
                                Width="70" Value="1.18" ValueChangedByUser="OnNumericChanged"/>
            </StackPanel>

            <TextBlock Text="Efectos" Style="{StaticResource TxtH2}" Margin="0,14,0,6"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Contorno:" Style="{StaticResource TxtLabel}" VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
              <local:LumNumeric x:Name="numOutline" Min="0" Max="10" Step="0.5" DecimalPlaces="1"
                                Width="70" Value="2" ValueChangedByUser="OnNumericChanged"/>
              <TextBlock Text="Sombra (0-255):" Style="{StaticResource TxtLabel}"
                         VerticalAlignment="Center" Margin="14,0,8,0"/>
              <local:LumNumeric x:Name="numShadow" Min="0" Max="255" Width="76" Value="140"
                                ValueChangedByUser="OnNumericChanged"/>
            </StackPanel>
            <TextBlock Style="{StaticResource TxtCaption}" Margin="0,6,0,0"
                       Text="Contorno por silueta (técnica del núcleo) y sombra suave bajo el texto."/>

            <TextBlock Text="Imagen de fondo (opcional)" Style="{StaticResource TxtH2}" Margin="0,14,0,6"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="txtImagePath" Width="250" TextChanged="OnThemeEdited"/>
              <ComboBox x:Name="cmbImageMode" Width="100" Margin="8,0,0,0" SelectionChanged="OnThemeEdited">
                <ComboBoxItem Content="Contener"/>
                <ComboBoxItem Content="Cubrir" IsSelected="True"/>
              </ComboBox>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconFolder}" Text="Examinar…"
                               Margin="8,0,0,0" Click="OnBrowseImage"/>
            </StackPanel>

            <TextBlock Text="Biblioteca de temas (data\themes)" Style="{StaticResource TxtH2}"
                       Margin="0,14,0,6"/>
            <TextBlock x:Name="lblThemeApplied" Text="En uso: —" Style="{StaticResource TxtLabel}"/>
            <ListBox x:Name="lstThemes" Height="110" Margin="0,6,0,0"
                     MouseDoubleClick="OnThemeDoubleClicked">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TxtBody}"/>
                    <TextBlock Text=" · En uso" Style="{StaticResource TxtCaption}"
                               Visibility="{Binding InUseVisibility}" Margin="8,0,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,9,0,0">
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconSave}" Text="Guardar"
                               Margin="0,0,6,6" Click="OnSaveTheme"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconDownload}" Text="Cargar"
                               Margin="0,0,6,6" Click="OnLoadTheme"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconEdit}" Text="Renombrar"
                               Margin="0,0,6,6" Click="OnRenameTheme"/>
              <local:LumButton Variant="Danger" Icon="{StaticResource IconTrash}" Text="Eliminar"
                               Margin="0,0,0,6" Click="OnDeleteTheme"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </local:Card>

      <!-- ======== vista previa ======== -->
      <local:Card Grid.Column="1" Title="Vista previa en vivo" Icon="{StaticResource IconEye}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <WrapPanel>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconRefresh}" Text="Restaurar"
                               Margin="0,0,6,6" Click="OnResetTheme"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconSave}" Text="Guardar en ajustes"
                               Margin="0,0,6,6" Click="OnSaveToSettings"/>
              <local:LumButton Variant="Primary" Icon="{StaticResource IconPlay}"
                               Text="Aplicar al escenario" Margin="0,0,0,6" Click="OnApplyToStage"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource TxtSmall}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Se re-dibuja con cada cambio. «Aplicar al escenario» reconstruye el escenario activo con este tema y refresca la proyección y la vista previa del núcleo (PNG)."/>
          </StackPanel>
          <Border CornerRadius="8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                  Background="{StaticResource PreviewBrush}" ClipToBounds="True">
            <Canvas x:Name="themePreview" SizeChanged="OnPreviewSizeChanged"/>
          </Border>
        </DockPanel>
      </local:Card>
    </Grid>
  </DockPanel>
</UserControl>
