<!--
  TriggersPage.xaml — «Activadores»: reglas automáticas evento → condición → acción.
-->
<UserControl x:Class="lumina.wpf.TriggersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <DockPanel>
    <local:PageHeader DockPanel.Dock="Top" Title="Activadores"
                      Subtitle="Reglas automáticas: evento → condición → acción"
                      Icon="{StaticResource IconLive}"/>

    <local:Card Title="Reglas (data\triggers\triggers.json)" Icon="{StaticResource IconList}">
      <DockPanel>
        <!-- botones -->
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <local:LumButton Variant="Primary" Icon="{StaticResource IconPlus}" Text="Nueva regla"
                           Margin="0,0,6,6" Click="OnTriggerAdd"/>
          <local:LumButton Variant="Secondary" Icon="{StaticResource IconEdit}" Text="Editar"
                           Margin="0,0,6,6" Click="OnTriggerEdit"/>
          <local:LumButton Variant="Secondary" Icon="{StaticResource IconCheck}" Text="Activar/Desactivar"
                           Margin="0,0,6,6" Click="OnTriggerToggle"/>
          <local:LumButton Variant="Danger" Icon="{StaticResource IconTrash}" Text="Eliminar"
                           Margin="0,0,0,6" Click="OnTriggerDelete"/>
        </WrapPanel>

        <TextBlock x:Name="lblTriggersInfo" DockPanel.Dock="Bottom" Style="{StaticResource TxtSmall}"
                   Margin="0,8,0,0"
                   Text="Eventos: item_changed · slide_changed · song_started · video_ended · midi_note · midi_cc · midi_program · api_webhook"/>

        <ListBox x:Name="lstTriggers" MinHeight="140" MouseDoubleClick="OnTriggerDoubleClicked"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource TxtH2}" Margin="0,0,8,0"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding EnabledLabel}" Style="{StaticResource TxtCaption}"
                             VerticalAlignment="Bottom"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Event}" Style="{StaticResource TxtSmall}"
                           Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                  <TextBlock Text="{Binding Match}" Style="{StaticResource TxtSmall}"
                             Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Actions}" Style="{StaticResource TxtCaption}"
                             Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </local:Card>
  </DockPanel>
</UserControl>
