<!--
  ExportPage.xaml — «Exportar»: escenario activo → PPTX (OpenXML) / PDF (escritor propio).
-->
<UserControl x:Class="lumina.wpf.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <DockPanel>
    <local:PageHeader DockPanel.Dock="Top" Title="Exportar"
                      Subtitle="Escenario → PPTX (OpenXML) / PDF (escritor propio)"
                      Icon="{StaticResource IconDownload}"/>

    <local:Card Title="Exportación del escenario activo" Icon="{StaticResource IconFileText}"
                VerticalAlignment="Top">
      <StackPanel MaxWidth="620" HorizontalAlignment="Left">
        <TextBlock x:Name="lblExportInfo" Style="{StaticResource TxtSmall}" TextWrapping="Wrap"
                   Text="Carga un escenario (En Vivo) y expórtalo con el tema actual.&#10;PPTX: PresentationML ISO/IEC-29500 (abre en PowerPoint 2007+, WPS, LibreOffice).&#10;PDF: 1.4 propio con fuentes Helvetica (cero dependencias)."/>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <local:LumButton Variant="Primary" Icon="{StaticResource IconDownload}"
                           Text="Exportar PPTX…" MinWidth="150" Click="OnExportPptx"/>
          <local:LumButton Variant="Secondary" Icon="{StaticResource IconFileText}"
                           Text="Exportar PDF…" MinWidth="150" Margin="8,0,0,0" Click="OnExportPdf"/>
        </StackPanel>
        <TextBlock Style="{StaticResource TxtCaption}" TextWrapping="Wrap" Margin="0,14,0,0"
                   Text="La exportación respeta el tema activo: fondo, tipografía, colores de acento e imágenes de las diapositivas. Los ítems de video se exportan como diapositiva de título «Video (reproducir en vivo)»."/>
      </StackPanel>
    </local:Card>
  </DockPanel>
</UserControl>
