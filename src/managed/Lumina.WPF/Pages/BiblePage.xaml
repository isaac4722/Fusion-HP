<!--
  BiblePage.xaml — «Biblia»: cargar pasaje (referencia/versión/versos por
  slide), importadores (.BIB · ZEFania XML) y búsqueda por palabra (FTS5).
-->
<UserControl x:Class="lumina.wpf.BiblePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <DockPanel>
    <local:PageHeader DockPanel.Dock="Top" Title="Biblia"
                      Subtitle="Pasajes y versículos para proyectar"
                      Icon="{StaticResource IconBook}"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- ======== cargar pasaje ======== -->
        <local:Card Title="Cargar pasaje" Icon="{StaticResource IconBook}">
          <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="38"/>
              <RowDefinition Height="38"/>
              <RowDefinition Height="38"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Referencia" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="txtRef" Grid.Row="0" Grid.Column="1" Text="Jn 3:16"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Versión" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="txtVersion" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Versos por slide" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <local:LumNumeric x:Name="numVerses" Grid.Row="2" Grid.Column="1" Min="1" Max="4" Width="70"
                              HorizontalAlignment="Left"
                              ToolTip="Cuántos versículos agrupar por diapositiva"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
              <local:LumButton Variant="Primary" Icon="{StaticResource IconPlay}"
                               Text="Cargar al escenario" Click="OnLoadToStage"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconSearch}"
                               Text="Resolver referencia" Margin="8,0,0,0" Click="OnResolve"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="lblResolve" Text="Ejemplos: Jn 3:16 · Sal 23:1-4 · Ap 21:4"
                     Style="{StaticResource TxtSmall}" Margin="0,9,0,0"/>
          </StackPanel>
        </local:Card>

        <!-- ======== leer la Biblia sin proyectar (v7.1.0 «OPERADOR») ======== -->
        <local:Card Title="Leer la Biblia (navegación directa · sin proyectar)" Icon="{StaticResource IconList}"
                    Margin="0,14,0,0">
          <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="38"/>
              <RowDefinition Height="38"/>
              <RowDefinition Height="38"/>
              <RowDefinition Height="38"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Libro" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="cboBook" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Capítulo" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <local:LumNumeric x:Name="numChapter" Grid.Row="1" Grid.Column="1" Min="1" Max="150" Width="70"
                              HorizontalAlignment="Left"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Versión" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="cboVersion" Grid.Row="2" Grid.Column="1"
                      ToolTip="Versiones instaladas en la base de datos (se llena al abrir la BD)"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Comparar con" Style="{StaticResource TxtLabel}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
              <ComboBox x:Name="cboVersion2" Width="180"
                        ToolTip="Segunda versión para COMPARAR el mismo pasaje lado a lado (v7.1.0)"/>
              <CheckBox x:Name="chkCompare" Content="Comparar las dos versiones" Margin="10,0,0,0"
                        VerticalAlignment="Center" IsChecked="False"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconEye}" Text="Leer capítulo"
                               ToolTip="Muestra el capítulo completo en la lista de abajo — el operador lee SIN proyectar"
                               Click="OnReadChapter"/>
              <local:LumButton Variant="Primary" Icon="{StaticResource IconPlay}"
                               Text="Cargar capítulo al escenario" Margin="8,0,0,0"
                               ToolTip="Carga el capítulo (o la comparación de versiones) como ítems del escenario"
                               Click="OnLoadChapterToStage"/>
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource TxtCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Toda la Biblia está disponible por libro y capítulo, sin buscar: «Leer capítulo» la muestra completa aquí (el operador la lee sin proyectar; doble clic en un versículo lo carga al escenario). Con «Comparar», cada versículo muestra DOS versiones lado a lado y la proyección las lleva juntas."/>
          </StackPanel>
        </local:Card>

        <!-- ======== importar ======== -->
        <local:Card Title="Importar biblias" Icon="{StaticResource IconDownload}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource TxtSmall}" TextWrapping="Wrap"
                       Text="Formatos admitidos: .BIB (directivas #BIB/#VERSION/#BOOKS), ZEFania XML (Reina Valera 1960, etc.), OSIS XML (académico: KJV, LXX…) y archivos JSON. La importación valida el archivo y luego inserta los versículos en la base de datos."
                       Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconBook}"
                               Text="Importar Biblia .BIB…" Click="OnImportBib"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconDownload}"
                               Text="Importar ZEFania XML…" Click="OnImportZefania"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconFileText}"
                               Text="Importar OSIS XML…" Margin="8,0,0,0" Click="OnImportOsis"/>
            </StackPanel>
          </StackPanel>
        </local:Card>

        <!-- ======== búsqueda por palabra ======== -->
        <local:Card Title="Buscar en la Biblia por palabra" Icon="{StaticResource IconSearch}"
                    Margin="0,14,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="txtSearch" Width="260" KeyDown="OnSearchKeyDown"
                       ToolTip="Búsqueda por palabra en TODAS las versiones (índice FTS5) — Enter para ejecutar"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconSearch}" Text="Buscar"
                               Margin="8,0,0,0" Click="OnSearchClick"/>
            </StackPanel>
            <ListBox x:Name="lstResults" Height="210" Margin="0,10,0,0"
                     MouseDoubleClick="OnResultDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Ref}" Style="{StaticResource TxtLabel}"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource TxtBody}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <!-- v7.1.0: segunda versión al comparar (lado a lado) -->
                    <TextBlock Text="{Binding TextB}" Style="{StaticResource TxtBody}"
                               TextWrapping="Wrap" Margin="0,2,0,0" Opacity="0.85"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="lblSearchInfo" Style="{StaticResource TxtCaption}" Margin="0,8,0,0"
                       Text="Busca en TODAS las versiones instaladas (índice FTS5). El término aparece resaltado con «…». Doble clic → carga el pasaje al escenario."/>
          </StackPanel>
        </local:Card>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
