<!--
  SettingsPage.xaml — «Ajustes»: API local, base de datos, respaldo
  (Drive/OneDrive-compatible) y acerca de.
-->
<UserControl x:Class="lumina.wpf.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:lumina.wpf">
  <DockPanel>
    <local:PageHeader DockPanel.Dock="Top" Title="Ajustes"
                      Subtitle="API local, base de datos e información del sistema"
                      Icon="{StaticResource IconGear}"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760">

        <!-- v7.1.0 «OPERADOR» (feedback #5): la «API local» (loopback, orientada
             a OBS/control externo) se ELIMINÓ de Ajustes — no funcionaba. El
             control remoto vive en Integraciones (mando móvil por LAN). -->

        <!-- ======== base de datos ======== -->
        <local:Card Title="Base de datos" Icon="{StaticResource IconDb}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Ruta de la BD" Style="{StaticResource TxtLabel}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtDbPath"/>
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconFolder}" Text="Explorar…"
                               Click="OnBrowseDb"/>
              <local:LumButton Variant="Primary" Icon="{StaticResource IconDb}" Text="Crear / Abrir BD"
                               Margin="8,0,0,0" Click="OnOpenDb"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconSave}" Text="Guardar ajustes"
                               Margin="8,0,0,0" Click="OnSaveSettings"/>
            </StackPanel>
          </StackPanel>
        </local:Card>

        <!-- ======== respaldo ======== -->
        <local:Card Title="Respaldo y sincronización" Icon="{StaticResource IconDrive}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Carpeta de respaldo" Style="{StaticResource TxtLabel}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="txtBackupFolder" Width="330"/>
              <local:LumButton Variant="Secondary" Icon="{StaticResource IconFolder}" Text="Explorar…"
                               Margin="8,0,0,0" Click="OnBrowseBackup"/>
              <local:LumButton Variant="Primary" Icon="{StaticResource IconUpload}" Text="Respaldar ahora"
                               Margin="8,0,0,0" Click="OnBackupNow"/>
            </StackPanel>
            <CheckBox x:Name="chkAutoBackup" Margin="0,10,0,0"
                      Content="Respaldar automáticamente al cerrar la aplicación (ZIP de la carpeta data\ en la carpeta elegida)"/>
            <TextBlock Style="{StaticResource TxtCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Compatible con Google Drive / OneDrive: apunte la carpeta a la del cliente de sincronización instalado (sin OAuth ni contraseñas) y sus canciones, biblias, temas y ajustes quedarán respaldados en la nube."/>
          </StackPanel>
        </local:Card>

        <!-- ======== proyección (v6.0.0: transición) ======== -->
        <local:Card Title="Proyección" Icon="{StaticResource IconMonitor}" Margin="0,14,0,0">
          <StackPanel>
            <CheckBox x:Name="chkFade" Margin="0,0,0,6"
                      Content="Fundir entre diapositivas (transición suave en la salida del proyector)"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Duración del fundido:" Style="{StaticResource TxtLabel}"
                         VerticalAlignment="Center"/>
              <local:LumNumeric x:Name="numFadeMs" Min="0" Max="5000" Width="90"
                                Margin="8,0,0,0" Value="220"/>
              <TextBlock Text="ms" Style="{StaticResource TxtLabel}"
                         VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource TxtCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="El fundido cruza desde el último fotograma proyectado (sin parpadeo ni destello del escritorio). Desactívelo para el corte inmediato clásico; la duración se ajusta a 0..5000 ms."/>
          </StackPanel>
        </local:Card>

        <!-- ======== acerca de ======== -->
        <local:Card Title="Acerca de" Icon="{StaticResource IconInfo2}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Núcleo (C++)" Style="{StaticResource TxtLabel}" Margin="0,0,0,3"/>
            <TextBlock x:Name="lblAboutCore" Text="…" Style="{StaticResource TxtBody}"/>
            <TextBlock Text="Interfaz" Style="{StaticResource TxtLabel}" Margin="0,9,0,3"/>
            <TextBlock x:Name="lblAboutUi" Text="WPF · .NET Framework 4.8" Style="{StaticResource TxtBody}"/>
            <TextBlock Text="Proyección" Style="{StaticResource TxtLabel}" Margin="0,9,0,3"/>
            <TextBlock Text="Nativa GDI vía LuminaCore (Windows 7 SP1 → Windows 11)"
                       Style="{StaticResource TxtBody}"/>
            <TextBlock Text="Versión: 5.4.0 «ESTUDIO» · BETA" Style="{StaticResource TxtCaption}"
                       Margin="0,10,0,0"/>
          </StackPanel>
        </local:Card>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
