<!--
  ==========================================================================
  Tokens.xaml — sistema de diseño «Lumina Studio» para WPF (v5.4.0 «ESTUDIO»)
  Tokens SEMÁNTICOS por rol (no hex sueltos en las páginas): paleta oscura con
  gradación de profundidad, ámbar de marca y colores de estado (skill
  qt-ui-design §1.4: color por rol, nunca portador único de estado).
  Escala tipográfica modular (base 13px · razón 1.2 — UI densa de control).
  ==========================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================ COLOR · superficies ==================== -->
  <Color x:Key="ColPage">#FF0E1116</Color>
  <Color x:Key="ColBar">#FF141821</Color>
  <Color x:Key="ColCard">#FF161B23</Color>
  <Color x:Key="ColCardBorder">#FF262D3A</Color>
  <Color x:Key="ColBarBorder">#FF232936</Color>
  <Color x:Key="ColInput">#FF1A2029</Color>
  <Color x:Key="ColInputBorder">#FF2C3442</Color>
  <Color x:Key="ColPreview">#FF0A0D12</Color>
  <Color x:Key="ColRowOdd">#FF12161D</Color>
  <Color x:Key="ColRowEven">#FF151A22</Color>
  <Color x:Key="ColRowHover">#FF1C2330</Color>
  <Color x:Key="ColRowSelected">#FF2A3140</Color>
  <Color x:Key="ColPopup">#FF1D242F</Color>

  <!-- ============================ COLOR · texto ========================== -->
  <Color x:Key="ColTextPrimary">#FFE8EAF0</Color>
  <Color x:Key="ColTextSecondary">#FF9AA3B5</Color>
  <Color x:Key="ColTextDisabled">#FF5B6472</Color>
  <Color x:Key="ColOnAccent">#FF191205</Color>

  <!-- ============================ COLOR · marca y estados ================ -->
  <Color x:Key="ColAccent">#FFF0A93B</Color>
  <Color x:Key="ColAccentDim">#FFB07E2B</Color>
  <Color x:Key="ColAccentGlow">#46F0A93B</Color>
  <Color x:Key="ColOk">#FF54C87C</Color>
  <Color x:Key="ColErr">#FFE5484D</Color>
  <Color x:Key="ColWarning">#FFF0A93B</Color>
  <Color x:Key="ColInfo">#FF5AA9E6</Color>

  <!-- Pinceles (los que consumen los estilos) -->
  <SolidColorBrush x:Key="PageBrush" Color="{StaticResource ColPage}"/>
  <SolidColorBrush x:Key="BarBrush" Color="{StaticResource ColBar}"/>
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColCard}"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource ColCardBorder}"/>
  <SolidColorBrush x:Key="BarBorderBrush" Color="{StaticResource ColBarBorder}"/>
  <SolidColorBrush x:Key="InputBrush" Color="{StaticResource ColInput}"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource ColInputBorder}"/>
  <SolidColorBrush x:Key="PreviewBrush" Color="{StaticResource ColPreview}"/>
  <SolidColorBrush x:Key="RowOddBrush" Color="{StaticResource ColRowOdd}"/>
  <SolidColorBrush x:Key="RowEvenBrush" Color="{StaticResource ColRowEven}"/>
  <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource ColRowHover}"/>
  <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource ColRowSelected}"/>
  <SolidColorBrush x:Key="PopupBrush" Color="{StaticResource ColPopup}"/>

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColTextPrimary}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColTextSecondary}"/>
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource ColTextDisabled}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource ColOnAccent}"/>

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColAccent}"/>
  <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource ColAccentDim}"/>
  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource ColOk}"/>
  <SolidColorBrush x:Key="ErrBrush" Color="{StaticResource ColErr}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColWarning}"/>
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource ColInfo}"/>

  <!-- Capa translúcida sobre tarjetas (profundidad sutil) -->
  <SolidColorBrush x:Key="CardGlowBrush" Color="#18FFFFFF"/>
  <SolidColorBrush x:Key="AccentLayerBrush" Color="#24F0A93B"/>

  <!-- ============================ TIPOGRAFÍA ============================= -->
  <!-- Escala modular 13px base, razón 1.2 (menor tercera): UI de control
       densa. Máx. 4 tamaños activos por pantalla (skill qt-ui-design §1.2). -->
  <sys:Double x:Key="SizeDisplay"   xmlns:sys="clr-namespace:System;assembly=mscorlib">19</sys:Double>
  <sys:Double x:Key="SizeH1"        xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
  <sys:Double x:Key="SizeH2"        xmlns:sys="clr-namespace:System;assembly=mscorlib">13.5</sys:Double>
  <sys:Double x:Key="SizeBody"      xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
  <sys:Double x:Key="SizeSmall"     xmlns:sys="clr-namespace:System;assembly=mscorlib">11.5</sys:Double>

  <FontFamily x:Key="FontUi">Segoe UI</FontFamily>
  <FontFamily x:Key="FontMono">Consolas</FontFamily>

  <!-- Familias de fuentes tipográficas completas -->
  <FontFamily x:Key="FontBody">Segoe UI</FontFamily>
  <FontFamily x:Key="FontHeading">Segoe UI</FontFamily>
  <FontFamily x:Key="FontClock">Consolas</FontFamily>

  <!-- ============================ FORMA · radios ========================= -->
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusButton">7</CornerRadius>
  <CornerRadius x:Key="RadiusPill">11</CornerRadius>
  <CornerRadius x:Key="RadiusInput">6</CornerRadius>
  <CornerRadius x:Key="RadiusBadge">5</CornerRadius>

  <!-- ============================ ESPACIADO ============================== -->
  <Thickness x:Key="PadCard">14,12,14,14</Thickness>
  <Thickness x:Key="PadInput">8,5,8,5</Thickness>
  <Thickness x:Key="PadPage">20,14,20,12</Thickness>
  <GridLength x:Key="NavWidth">234</GridLength>

  <!-- ============================ DURACIONES (ms) ======================= -->
  <!-- Presupuesto ≤ 150ms para elementos pequeños (skill §1.1: ≤ 400ms) -->
  <Duration x:Key="DurFast">0:0:0.09</Duration>
  <Duration x:Key="DurMid">0:0:0.16</Duration>

  <!-- ============================ PLANTILLAS DE TEXTO =================== -->
  <Style x:Key="TxtBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="{StaticResource SizeBody}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="TxtSmall" TargetType="TextBlock" BasedOn="{StaticResource TxtBody}">
    <Setter Property="FontSize" Value="{StaticResource SizeSmall}"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
  </Style>
  <Style x:Key="TxtCaption" TargetType="TextBlock" BasedOn="{StaticResource TxtSmall}">
    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
  </Style>
  <Style x:Key="TxtH1" TargetType="TextBlock" BasedOn="{StaticResource TxtBody}">
    <Setter Property="FontSize" Value="{StaticResource SizeH1}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="TxtH2" TargetType="TextBlock" BasedOn="{StaticResource TxtBody}">
    <Setter Property="FontSize" Value="{StaticResource SizeH2}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="TxtLabel" TargetType="TextBlock" BasedOn="{StaticResource TxtSmall}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
  </Style>

</ResourceDictionary>
