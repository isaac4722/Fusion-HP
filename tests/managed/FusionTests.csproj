<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Fusion.Tests</RootNamespace>
    <AssemblyName>FusionTests</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>4.0.1</Version>
    <AssemblyTitle>Fusion HP Tests</AssemblyTitle>
    <Product>Fusion HP</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <ProjectReference Include="..\..\src\managed\FusionShared\FusionShared.csproj" />
    <ProjectReference Include="..\..\src\managed\FusionStudio\FusionStudio.csproj" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- dependencias nombradas por las pruebas (hint directo) -->
    <Reference Include="Ookii.Dialogs.Wpf">
      <HintPath>..\..\third_party\net\Ookii.Dialogs\1.0.0\Ookii.Dialogs.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="BouncyCastle.Crypto">
      <HintPath>..\..\third_party\net\BouncyCastle\1.8.9\BouncyCastle.Crypto.dll</HintPath>
    </Reference>
    <Reference Include="PdfSharp-wpf">
      <HintPath>..\..\third_party\net\PdfSharp\1.50.5147\PdfSharp-wpf.dll</HintPath>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

</Project>
